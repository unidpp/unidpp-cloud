{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unidpp-projector",
  "main": "../src/workers/views/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "af1920686175ca6d92a677e02bdda75d",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.yaml"],
      "fallthrough": true
    }
  ],
  "services": [
    {
      "binding": "ESTATE",
      "service": "unidpp"
    }
  ]
}
